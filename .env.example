# Copy to .env.local for local development. Never commit real secrets.
# When DATABASE_URL is unset, Auvra uses an embedded Postgres (PGlite) in .data/pglite.

# Postgres connection. The hosted app receives this automatically. Do not commit a real URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/auvra?schema=public"

# Required for customer and admin sign-in. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public site origin used for Stripe return URLs and metadata.
APP_URL="http://localhost:3847"
NEXT_PUBLIC_APP_URL="http://localhost:3847"

# One-time admin bootstrap. The server creates this admin if the email does not exist.
# Never commit real values. There is no default password in the application code.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Stripe (test mode keys start with sk_test_ and pk_test_). Leave blank to use development checkout.
# Development checkout records an order and does not capture a payment.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloudinary image uploads. Without these, admins can paste image URLs, and local dev can store files in public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional email delivery for verification and password reset (Resend).
RESEND_API_KEY=""
EMAIL_FROM="Auvra <hello@auvra.store>"

# Local only. When "true" and email is not configured, reset and verification links are shown once on screen.
# Leave unset in production.
ALLOW_DEV_AUTH_LINKS=""
